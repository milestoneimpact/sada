{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/milestoneimpact/sada/blob/main/docs/plan.schema.json",
  "title": "خطّة صدى",
  "description": "صفوف الخطّة بأعمدة القالب: اليوم، الساعة، المنصة، النص، الملف، ملاحظة. الساعة بتوقيت المالك.",
  "type": "array",
  "maxItems": 200,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "day",
      "time",
      "platform",
      "text"
    ],
    "properties": {
      "day": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "اليوم YYYY-MM-DD"
      },
      "time": {
        "type": "string",
        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
        "description": "الساعة HH:MM بتوقيت المالك"
      },
      "platform": {
        "enum": [
          "linkedin",
          "x"
        ],
        "description": "المنصة"
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "description": "النص كما يُنشر؛ في X سطر --- يفصل تغريدات السلسلة"
      },
      "media": {
        "type": "string",
        "description": "مسار الصورة أو المقطع (اختياريّ)"
      },
      "note": {
        "type": "string",
        "description": "ملاحظة لا تُنشر"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "platform": {
              "const": "linkedin"
            }
          }
        },
        "then": {
          "properties": {
            "text": {
              "maxLength": 3000
            }
          }
        }
      }
    ]
  }
}
