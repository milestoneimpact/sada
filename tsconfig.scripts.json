{
  // نصوصُ الرسم والتدقيق (scripts/) — تُفحَص كما تُفحَص الاختبارات.
  //
  // كانت خارج كلِّ فحص، و`tsx` يمحو الأنواع ولا يقرؤها: فحين زادت
  // `PanelData` أربعةَ حقول، ظلّت الفِخاخُ هنا ترسم بلا أربعتِها —
  // ورسمت بنجاح، ودقّق المدقّقان لوحةً ينقصها ما لم يُرسَم قطّ.
  //
  // **ففخٌّ لا يُفحَص يشيخ صامتا، ومدقّقٌ على فخٍّ شائخ يقول «لا ملحوظة»
  // وهو لم يقرأ الجديد أصلا.**
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    // ‏`cloudflare:email` لا يوجد خارج Worker: بديلُه الصوريّ للأنواع (D-245)
    "paths": { "cloudflare:email": ["./src/test/cloudflareEmail.ts"] }
  },
  "include": ["scripts/**/*.ts"]
}
